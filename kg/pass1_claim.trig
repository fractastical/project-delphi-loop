@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pk: <https://w3id.org/delphi/ontology/> .
@prefix pkr: <https://w3id.org/delphi/resource/> .
@prefix sub: <https://w3id.org/delphi/np/pass1-example-claim/> .

sub:Head {
  <https://w3id.org/delphi/np/pass1-example-claim> a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  pkr:claim-example-allometry a pk:Claim ;
    pk:targetScript "example/pass1_naive_fit.py" ;
    pk:artifactSha256 "26455f9f9c24c80bde0d7d8dceabd2a759ece2c070624b42ecb340744b866362" ;
    pk:measuredR2 "-0.246106"^^xsd:double ;
    pk:measuredRMSE "44.2323"^^xsd:double ;
    pk:assessedBy pkr:model-gemini-4-argon ;
    pk:hasScore "0.4940"^^xsd:double ;
  pk:evidenceAgainst
    "remediation needed: Fit the power law y = a * x^b across the full organism (all 12 rows of example/data.csv, accounting for both head and body modules) instead of fitting a linear line only to the 6 head rows (line 49).",
    "remediation needed: Report the fitted power-law exponents b_head and b_body and verify that full-dataset R^2 exceeds 0.99." ;
    pk:verdict "needs_remediation" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo pkr:model-gemini-4-argon ;
    prov:wasDerivedFrom <file://example/pass1_metrics.json> .
}

sub:pubinfo {
  <https://w3id.org/delphi/np/pass1-example-claim> npx:hasTrustyDigest "abd439829327262020a1bf096f155cdf" .
}
